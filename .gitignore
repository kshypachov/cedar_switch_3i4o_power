# Build output. west, sysbuild and CLion all default to build/ inside the
# application directory; none of it belongs in the repository.
/build/
/build*/
cmake-build-*/

# Twister output, including the sim tier run through tests/ci. Twister does not
# overwrite an existing output directory, it suffixes a counter, so the numbered
# forms have to be covered too.
twister-out/
twister-out.*/
.twister-tmp/
.twister-tmp.*/

# Python bytecode and pytest state from tools/api-contract. Both are generated
# beside the sources they belong to, and neither is reproducible across
# interpreter versions.
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# macOS directory metadata.
.DS_Store

# Per-machine tool configuration. .codex/config.toml points at a localhost
# port that differs on every machine, and Claude Code's settings.local.json is
# local by definition; the shared parts of both live in files without
# ".local" in the name.
/.codex/
/.claude/settings.local.json

# Editor scratch files.
*.swp
*~

# Frontend (src/web/frontend). node_modules and dist are reproduced by
# `npm ci && npm run build` from package-lock.json; the API types are generated
# from docs/device-development/openapi.json on every typecheck, test and build,
# so a copy in the repository could only ever be stale.
/src/web/frontend/node_modules/
/src/web/frontend/dist/
/src/web/frontend/src/api/schema.gen.ts
/src/web/frontend/test-results/
/src/web/frontend/playwright-report/
