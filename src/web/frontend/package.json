{
  "name": "cedar-web",
  "version": "0.1.0",
  "private": true,
  "description": "The browser application of the Cedar switch, served by the device itself.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../../../docs/device-development/openapi.json -o src/api/schema.gen.ts",
    "pretypecheck": "npm run generate:api",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:api",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/stamp.mjs",
    "e2e": "playwright test",
    "dev": "vite"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
