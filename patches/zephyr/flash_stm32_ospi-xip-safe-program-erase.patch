 }
 #endif /* CONFIG_FLASH_STM32_NOR_MEMMAP */
 
+#ifdef CONFIG_FLASH_STM32_OSPI_XIP
+/*
+ * XIP-safe program/erase (see flash_stm32_ospi_xip.h).  These run from
+ * flash; only the guarded chunk functions they call run from SRAM.
+ */
+static inline bool ospi_xip_buf_in_sram(const void *buf, size_t len)
+{
+	uintptr_t b = (uintptr_t)buf;
+
+	/* Internal SRAM 0x2000_0000..0x2FFF_FFFF (SRAM1-3) and 0x2800_0000 (SRAM4) */
+	return ((b >> 28) == 0x2U) && (((b + len - 1U) >> 28) == 0x2U);
+}
+
+static inline void ospi_xip_yield(void)
+{
+#ifdef CONFIG_FLASH_STM32_OSPI_XIP_YIELD
+	if (!k_is_in_isr() && !k_is_pre_kernel()) {
+		k_yield();
+	}
+#endif
+}
+
+static int flash_stm32_ospi_xip_write(const struct device *dev, off_t addr,
+				      const void *data, size_t size)
+{
+	struct flash_stm32_ospi_data *dev_data = dev->data;
+	const uint8_t *src = data;
+	uint8_t bounce[SPI_NOR_PAGE_SIZE];
+	off_t start = addr;
+	size_t total = size;
+	int ret = 0;
+
+	ospi_lock_thread(dev);
+
+	while (size > 0 && ret == 0) {
+		size_t chunk = MIN(size, (size_t)CONFIG_FLASH_STM32_OSPI_XIP_WRITE_CHUNK);
+		size_t done = 0;
+
+		/* One guarded chunk: up to WRITE_CHUNK bytes, page by page */
+		while (done < chunk && ret == 0) {
+			size_t to_write = MIN(chunk - done, SPI_NOR_PAGE_SIZE);
+			const uint8_t *p = src + done;
+
+			/* Don't write across a page boundary */
+			if ((((addr + done) + to_write - 1U) / SPI_NOR_PAGE_SIZE) !=
+			    ((addr + done) / SPI_NOR_PAGE_SIZE)) {
+				to_write = SPI_NOR_PAGE_SIZE - ((addr + done) % SPI_NOR_PAGE_SIZE);
+			}
+			/* Source must be readable while the flash is not: bounce */
+			if (!ospi_xip_buf_in_sram(p, to_write)) {
+				memcpy(bounce, p, to_write);
+				p = bounce;
+			}
+			ret = flash_stm32_ospi_xip_program_page(&dev_data->xip,
+								(uint32_t)(addr + done), p,
+								(uint32_t)to_write);
+			done += to_write;
+		}
+		addr += done;
+		src += done;
+		size -= done;
+		if (size > 0) {
+			ospi_xip_yield();
+		}
+	}
+
+	flash_stm32_ospi_xip_cache_invalidate(&dev_data->xip, (uint32_t)start, (uint32_t)total);
+	ospi_unlock_thread(dev);
+
+	if (ret != 0) {
+		LOG_ERR("XIP write failed at 0x%lx: %d", (long)addr, ret);
+	}
+	return ret;
+}
+
+static int flash_stm32_ospi_xip_erase(const struct device *dev, off_t addr, size_t size)
+{
+	struct flash_stm32_ospi_data *dev_data = dev->data;
+	off_t start = addr;
+	size_t total = size;
+	int ret = 0;
+
+	ospi_lock_thread(dev);
+
+	while (size > 0 && ret == 0) {
+		uint32_t blk = SPI_NOR_SECTOR_SIZE;
+
+		if (CONFIG_FLASH_STM32_OSPI_XIP_MAX_ERASE_SIZE >= 65536 &&
+		    (addr % 65536U) == 0 && size >= 65536U) {
+			blk = 65536U;
+		} else if (CONFIG_FLASH_STM32_OSPI_XIP_MAX_ERASE_SIZE >= 32768 &&
+			   (addr % 32768U) == 0 && size >= 32768U) {
+			blk = 32768U;
+		}
+		ret = flash_stm32_ospi_xip_erase_block(&dev_data->xip, (uint32_t)addr, blk);
+		addr += blk;
+		size -= blk;
+		if (size > 0) {
+			ospi_xip_yield();
+		}
+	}
+
+	flash_stm32_ospi_xip_cache_invalidate(&dev_data->xip, (uint32_t)start, (uint32_t)total);
+	ospi_unlock_thread(dev);
+
+	if (ret != 0) {
+		LOG_ERR("XIP erase failed at 0x%lx: %d", (long)addr, ret);
+	}
+	return ret;
+}
+
+/* Called from init when the bootloader left the controller memory-mapped */
+static int flash_stm32_ospi_xip_setup(const struct device *dev)
+{
+	const struct flash_stm32_ospi_config *dev_cfg = dev->config;
+	struct flash_stm32_ospi_data *dev_data = dev->data;
+	int ret;
+
+	k_sem_init(&dev_data->sem, 1, 1);
+	k_sem_init(&dev_data->sync, 0, 1);
+
+#if defined(CONFIG_FLASH_PAGE_LAYOUT)
+	dev_data->layout.pages_size = SPI_NOR_SECTOR_SIZE;
+	dev_data->layout.pages_count = dev_cfg->flash_size / SPI_NOR_SECTOR_SIZE;
+#endif
+	dev_data->page_size = SPI_NOR_PAGE_SIZE;
+
+	ret = flash_stm32_ospi_xip_init(&dev_data->xip, dev_data->hospi.Instance,
+					STM32_OSPI_BASE_ADDRESS, dev_cfg->flash_size);
+	if (ret != 0) {
+		LOG_ERR("XIP-safe path init failed: %d", ret);
+		return ret;
+	}
+	LOG_INF("NOR in MemoryMapped mode, XIP-safe program/erase enabled");
+	return 0;
+}
+int flash_stm32_ospi_xip_get_stats(const struct device *dev, struct ospi_xip_stats *st,
+				   bool reset)
+{
+	struct flash_stm32_ospi_data *dev_data = dev->data;
+
+	if (!dev_data->xip.initialized) {
+		return -ENOTSUP;
+	}
+	st->max_guard_cycles = dev_data->xip.max_guard_cycles;
+	st->guard_count = dev_data->xip.guard_count;
+	if (reset) {
+		dev_data->xip.max_guard_cycles = 0;
+		dev_data->xip.guard_count = 0;
+	}
+	return 0;
+}
+#endif /* CONFIG_FLASH_STM32_OSPI_XIP */
+
