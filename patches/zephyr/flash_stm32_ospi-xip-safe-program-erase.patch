diff --git a/drivers/flash/Kconfig.stm32_ospi b/drivers/flash/Kconfig.stm32_ospi
index fda241212f6..225828ae355 100644
--- a/drivers/flash/Kconfig.stm32_ospi
+++ b/drivers/flash/Kconfig.stm32_ospi
@@ -24,3 +24,46 @@ config FLASH_STM32_OSPI
 					$(DT_STM32_OCTOSPI_HAS_DMA)
 	help
 	  Enable OSPI-NOR support on the STM32 family of processors.
+
+config FLASH_STM32_OSPI_XIP
+	bool "XIP-safe program/erase (run from and write to the same OSPI NOR)"
+	depends on FLASH_STM32_OSPI
+	depends on FLASH_STM32_NOR_MEMMAP
+	depends on XIP
+	depends on SOC_SERIES_STM32U5X
+	help
+	  Program/erase the external NOR flash while the firmware executes from
+	  it (XIP), the way ESP32 does: the operation is split into page/sector
+	  sized chunks, each chunk runs from SRAM with interrupts masked and the
+	  controller temporarily out of memory-mapped mode, and the memory-mapped
+	  configuration (as programmed by the bootloader) is restored afterwards.
+	  Interrupt handlers that must keep running during a chunk have to be
+	  zero-latency IRQs whose code and data live in SRAM.
+
+if FLASH_STM32_OSPI_XIP
+
+config FLASH_STM32_OSPI_XIP_MAX_ERASE_SIZE
+	int "Largest erase command used per guarded chunk (bytes)"
+	default 4096
+	range 4096 65536
+	help
+	  4096 (sector erase, worst case 400 ms with interrupts masked),
+	  32768 (block erase 32K, up to 1.6 s) or 65536 (block erase 64K, up to
+	  2 s).  Larger blocks erase faster overall but mask interrupts longer.
+
+config FLASH_STM32_OSPI_XIP_WRITE_CHUNK
+	int "Bytes programmed per guarded chunk"
+	default 256
+	range 256 4096
+	help
+	  Multiple of the 256 byte page.  Each page takes up to 3 ms with
+	  interrupts masked; larger chunks reduce the guard entry/exit overhead.
+
+config FLASH_STM32_OSPI_XIP_YIELD
+	bool "Yield between chunks"
+	default y
+	help
+	  Call k_yield() after every guarded chunk so equal-priority threads
+	  get to run during long operations (ESP-IDF SPI_FLASH_YIELD_DURING_ERASE).
+
+endif # FLASH_STM32_OSPI_XIP
