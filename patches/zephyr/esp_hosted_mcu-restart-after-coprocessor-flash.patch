Date: Mon, 14 Sep 2026 00:00:00 +0300
Subject: [PATCH] drivers: esp_hosted_mcu: restart the link after the
 coprocessor was re-flashed

The core learns the coprocessor's firmware version once, at init, and the
Wi-Fi driver runs the coprocessor's esp_wifi bring-up (WifiInit, station
mode, WifiStart) once, at its own init. When the coprocessor is restarted
behind the driver's back - on this product it is re-flashed through its UART
ROM loader and released from reset by the owner of its EN line - the SPI
transport keeps working and the boot priv event still arrives, but the
version is never updated (the event only fills an unknown version) and the
new firmware never gets WifiInit: scans and connects fail until the host
reboots.

Add two calls, neither used by the driver itself, so nothing changes unless
an application calls them:

- esp_hosted_mcu_restart(timeout) forgets the version, any pending RPC round
  trip, the frame stride and receive data from the previous run (a new
  optional transport op, flush_rx, empties the SPI stash; the receive thread
  drops its carried partial frame), then waits for the boot event or asks
  GetCoprocessorFwVersion until the timeout. It does not touch the reset
  line.
- esp_hosted_mcu_wifi_restart() reports a station association or soft AP of
  the previous run as lost and runs the bring-up again; the init sequence is
  moved into a function both share. A Wi-Fi device whose init failed at boot
  stays not ready in the kernel and returns -ENODEV.
---
--- a/drivers/misc/esp_hosted_mcu/esp_hosted_mcu.h
+++ b/drivers/misc/esp_hosted_mcu/esp_hosted_mcu.h
@@ -222,6 +222,12 @@
 	 */
 	void (*set_tx_bufsz)(const struct device *dev, uint16_t size);
 	/*
+	 * Optional: forget receive data the backend holds for the core, such as
+	 * frames a transmit shifted in. Called by esp_hosted_mcu_restart(), when
+	 * anything still buffered belongs to the coprocessor's previous run.
+	 */
+	void (*flush_rx)(const struct device *dev);
+	/*
 	 * True when one transfer() may carry several back-to-back frames (each
 	 * with its own header) that the coprocessor splits on receive. SDIO does;
 	 * SPI moves one fixed-size frame per transaction.
@@ -270,6 +276,37 @@
  */
 uint32_t esp_hosted_mcu_fw_version(void);
 
+/*
+ * Re-establish the link after the coprocessor was restarted behind the
+ * driver's back - for example re-flashed through its UART ROM loader and
+ * released from reset by another owner of its EN line. The transport itself
+ * survives such a restart, but the driver still holds the previous run's
+ * firmware version and receive state, and init never runs again.
+ *
+ * Forgets the learned firmware version, any pending RPC round trip and
+ * receive data buffered from the previous run, then waits for the boot event
+ * or asks for the version until the timeout. The reset line is not touched.
+ * RPC callers block for the duration.
+ *
+ * Returns 0 once the coprocessor reported a non-zero version (read it with
+ * esp_hosted_mcu_fw_version()), -ETIMEDOUT if it did not within the timeout,
+ * -ENODEV if the core never came up.
+ */
+int esp_hosted_mcu_restart(k_timeout_t timeout);
+
+/*
+ * Implemented by the Wi-Fi driver. After esp_hosted_mcu_restart(), run the
+ * coprocessor's esp_wifi bring-up again: MAC query, WifiInit, station mode,
+ * WifiStart. A station association or soft AP from the previous run is
+ * reported lost first, as the coprocessor's own disconnect event would.
+ *
+ * Returns 0 on success, -EIO when the coprocessor refused a step, and -ENODEV
+ * when the Wi-Fi device failed its init at boot: the kernel keeps such a
+ * device not ready and the network stack never initialised its interface,
+ * which only a reboot of the host clears.
+ */
+int esp_hosted_mcu_wifi_restart(void);
+
 /* Transmit path counters: frames queued and transport writes issued (aggregates). */
 void esp_hosted_mcu_tx_stats(uint32_t *frames, uint32_t *writes);
 void esp_hosted_mcu_rx_stats(uint32_t *reads, uint32_t *bytes, uint32_t *frames,
--- a/drivers/misc/esp_hosted_mcu/esp_hosted_mcu.c
+++ b/drivers/misc/esp_hosted_mcu/esp_hosted_mcu.c
@@ -59,6 +59,8 @@
 	k_tid_t tid;
 	uint32_t fw_version;
 	bool rx_stride_aligned;
+	/* Set by esp_hosted_mcu_restart(): the receive thread drops its carry. */
+	atomic_t rx_flush;
 	/* Transmit path statistics: frames queued and transport writes issued. */
 	uint32_t tx_frames;
 	uint32_t tx_writes;
@@ -561,6 +563,11 @@
 	ARG_UNUSED(p3);
 
 	while (true) {
+		/* A partial frame from before a coprocessor restart never completes. */
+		if (atomic_cas(&data->rx_flush, 1, 0)) {
+			carry = 0;
+		}
+
 		if (!cfg->transport->data_ready(dev)) {
 			/*
 			 * Block on the transport's data-ready interrupt so a
@@ -796,6 +803,87 @@
 	return esp_hosted_mcu_data_0.fw_version;
 }
 
+int esp_hosted_mcu_restart(k_timeout_t timeout)
+{
+	const struct device *dev = esp_hosted_mcu_data_0.dev;
+	const k_timepoint_t end = sys_timepoint_calc(timeout);
+	const struct esp_hosted_mcu_config *cfg;
+	struct esp_hosted_mcu_data *data;
+
+	if (dev == NULL) {
+		return -ENODEV;
+	}
+	cfg = dev->config;
+	data = dev->data;
+
+	/*
+	 * Hold the RPC lock throughout: a round trip that was in flight when the
+	 * coprocessor went down can only time out, and a new one must not
+	 * interleave with the version query below. The mutex is recursive, so
+	 * the query takes it again on this thread.
+	 */
+	k_mutex_lock(&esp_hosted_mcu_rpc_lock, K_FOREVER);
+
+	K_SPINLOCK(&esp_hosted_mcu_rpc_ctx_lock) {
+		esp_hosted_mcu_rpc.pending = false;
+	}
+
+	/*
+	 * The version and the frame stride were learned from the previous run's
+	 * boot event, and the priv event only fills a version that is unknown.
+	 * A partial frame the receive thread carries, and frames the transport
+	 * stashed, belong to that run too; the thread drops its carry within one
+	 * poll interval.
+	 */
+	data->fw_version = 0;
+	data->rx_stride_aligned = false;
+	atomic_set(&data->rx_flush, 1);
+	if (cfg->transport->flush_rx != NULL) {
+		cfg->transport->flush_rx(dev);
+	}
+
+	while (data->fw_version == 0 && !sys_timepoint_expired(end)) {
+		Rpc req = Rpc_init_zero;
+		Rpc resp = Rpc_init_zero;
+
+		/* As at init, let the boot event land before asking over RPC. */
+		for (k_timepoint_t wait =
+			     sys_timepoint_calc(K_MSEC(ESP_HOSTED_MCU_BOOT_EVENT_WAIT));
+		     data->fw_version == 0 && !sys_timepoint_expired(wait) &&
+		     !sys_timepoint_expired(end);) {
+			k_msleep(10);
+		}
+		if (data->fw_version != 0 || sys_timepoint_expired(end)) {
+			break;
+		}
+
+		/* A coprocessor still booting does not answer; the loop asks again. */
+		req.msg_id = RpcId_Req_GetCoprocessorFwVersion;
+		if (esp_hosted_mcu_rpc_call(&req, &resp, ESP_HOSTED_MCU_BOOT_EVENT_WAIT) == 0) {
+			const Rpc_Resp_GetCoprocessorFwVersion *fw =
+				&resp.payload.resp_get_coprocessor_fwversion;
+
+			data->fw_version =
+				ESP_HOSTED_MCU_FW_VERSION_VAL(fw->major1, fw->minor1, fw->patch1);
+		}
+		pb_release(Rpc_fields, &resp);
+	}
+
+	k_mutex_unlock(&esp_hosted_mcu_rpc_lock);
+
+	if (data->fw_version == 0) {
+		LOG_WRN("coprocessor did not report a version after restart");
+		return -ETIMEDOUT;
+	}
+
+	LOG_INF("coprocessor restarted, firmware v%u.%u.%u",
+		ESP_HOSTED_MCU_FW_VERSION_MAJOR(data->fw_version),
+		ESP_HOSTED_MCU_FW_VERSION_MINOR(data->fw_version),
+		ESP_HOSTED_MCU_FW_VERSION_PATCH(data->fw_version));
+
+	return 0;
+}
+
 /*
  * Ask the coprocessor for its firmware version and log what it runs against
  * the version this host was built for. The version is informational: the
--- a/drivers/misc/esp_hosted_mcu/esp_hosted_mcu_spi.c
+++ b/drivers/misc/esp_hosted_mcu/esp_hosted_mcu_spi.c
@@ -394,9 +394,24 @@
 	return 0;
 }
 
+static void esp_hosted_mcu_spi_flush_rx(const struct device *dev)
+{
+	struct esp_hosted_mcu_spi_data *data = &esp_hosted_mcu_spi_data_0;
+
+	ARG_UNUSED(dev);
+
+	/* Frames shifted in before the coprocessor restarted are from its previous run. */
+	k_mutex_lock(&data->lock, K_FOREVER);
+	data->stash_head = 0;
+	data->stash_tail = 0;
+	data->stash_count = 0;
+	k_mutex_unlock(&data->lock);
+}
+
 const struct esp_hosted_mcu_transport_api esp_hosted_mcu_spi_api = {
 	.init = esp_hosted_mcu_spi_init,
 	.transfer = esp_hosted_mcu_spi_transfer,
 	.data_ready = esp_hosted_mcu_spi_data_ready,
 	.wait_for_rx = esp_hosted_mcu_spi_wait_for_rx,
+	.flush_rx = esp_hosted_mcu_spi_flush_rx,
 };
--- a/drivers/wifi/esp_hosted_mcu/esp_hosted_mcu.c
+++ b/drivers/wifi/esp_hosted_mcu/esp_hosted_mcu.c
@@ -943,23 +943,16 @@
 	cfg->dump_hesigb_enable = 0;
 }
 
-/* Register with the core and run the coprocessor esp_wifi init sequence. */
-static int esp_hosted_mcu_wifi_init(const struct device *dev)
+/*
+ * The coprocessor's esp_wifi bring-up. Run at init, and again by
+ * esp_hosted_mcu_wifi_restart() after the coprocessor restarted with no
+ * memory of it.
+ */
+static int esp_hosted_mcu_wifi_bringup(struct esp_hosted_mcu_data *data)
 {
-	struct esp_hosted_mcu_data *data = dev->data;
 	Rpc req = Rpc_init_zero;
 	Rpc resp = Rpc_init_zero;
 
-	if (!device_is_ready(DEVICE_DT_GET(DT_INST_PARENT(0)))) {
-		LOG_ERR("esp-hosted-mcu core not ready");
-		return -ENODEV;
-	}
-
-	k_sem_init(&data->scan_sem, 0, 1);
-
-	/* Route asynchronous coprocessor events (connect/disconnect/scan) here. */
-	esp_hosted_mcu_register_rpc_event(esp_hosted_mcu_handle_event, data);
-
 	/*
 	 * Read the STA and AP MAC addresses the coprocessor reports.
 	 * IfaceMacAddrSetGet exists only in firmware 3.x; firmware that did not
@@ -1032,6 +1025,68 @@
 	return 0;
 }
 
+/* Register with the core and run the coprocessor esp_wifi init sequence. */
+static int esp_hosted_mcu_wifi_init(const struct device *dev)
+{
+	struct esp_hosted_mcu_data *data = dev->data;
+
+	if (!device_is_ready(DEVICE_DT_GET(DT_INST_PARENT(0)))) {
+		LOG_ERR("esp-hosted-mcu core not ready");
+		return -ENODEV;
+	}
+
+	k_sem_init(&data->scan_sem, 0, 1);
+
+	/* Route asynchronous coprocessor events (connect/disconnect/scan) here. */
+	esp_hosted_mcu_register_rpc_event(esp_hosted_mcu_handle_event, data);
+
+	return esp_hosted_mcu_wifi_bringup(data);
+}
+
+int esp_hosted_mcu_wifi_restart(void)
+{
+	const struct device *dev = DEVICE_DT_INST_GET(0);
+	struct esp_hosted_mcu_data *data = dev->data;
+	struct net_if *sta = data->iface[ESP_HOSTED_MCU_IFACE_STA];
+	enum wifi_iface_state prev;
+
+	/*
+	 * A device whose init failed stays not ready: device_init() refuses a
+	 * second call and the network stack skipped its interface. Nothing here
+	 * can change that without going around the kernel.
+	 */
+	if (!device_is_ready(dev)) {
+		return -ENODEV;
+	}
+
+	/*
+	 * The coprocessor dropped any association with its previous run and sends
+	 * no disconnect event for it, so report the loss as that event would.
+	 */
+	prev = data->state[ESP_HOSTED_MCU_IFACE_STA];
+	data->state[ESP_HOSTED_MCU_IFACE_STA] = WIFI_STATE_DISCONNECTED;
+	if (sta != NULL && prev == WIFI_STATE_ASSOCIATING) {
+		wifi_mgmt_raise_connect_result_event(sta, WIFI_STATUS_CONN_FAIL);
+	} else if (sta != NULL && prev == WIFI_STATE_COMPLETED) {
+		if (IS_ENABLED(CONFIG_WIFI_STA_AUTO_DHCPV4)) {
+			net_dhcpv4_stop(sta);
+		}
+		net_if_dormant_on(sta);
+		wifi_mgmt_raise_disconnect_result_event(sta, 0);
+	} else {
+		/* Not associated: nothing to report. */
+	}
+
+#if defined(CONFIG_WIFI_ESP_HOSTED_MCU_AP_STA_MODE)
+	if (data->state[ESP_HOSTED_MCU_IFACE_AP] == WIFI_STATE_COMPLETED) {
+		data->state[ESP_HOSTED_MCU_IFACE_AP] = WIFI_STATE_DISCONNECTED;
+		wifi_mgmt_raise_ap_disable_result_event(data->iface[ESP_HOSTED_MCU_IFACE_AP], 0);
+	}
+#endif
+
+	return esp_hosted_mcu_wifi_bringup(data);
+}
+
 static const struct wifi_mgmt_ops esp_hosted_mcu_mgmt = {
 	.scan = esp_hosted_mcu_scan,
 	.connect = esp_hosted_mcu_connect,
