/ {
	chosen {
		/* Settings in ZMS on the 6 MB partition at offset 0 (see prj.conf) */
		zephyr,settings-partition = &storage_zms_partition;
		/* HLW8032 energy meter, modules/energy-meter */
		cedar,hlw8032-uart = &usart2;
	};

	fstab {
		compatible = "zephyr,fstab";

		lfs0: lfs0 {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs";
			partition = <&storage_partition>;
			automount;
			read-size = <256>;
			prog-size = <256>;
			/* 4096 (a whole block) since 2026-09-19: the image store's metadata save
			 * (tmp + sync + rename) 83 -> 32 ms, rename 75 -> 23 ms (reports/littlefs-speed).
			 * Every open file takes this much from FS_LITTLEFS_FC_HEAP_SIZE (prj.conf). */
			cache-size = <4096>;
			/* 256 B = 2048 blocks, more than the partition's 1280; 512 measured the same */
			lookahead-size = <256>;
			block-cycles = <1024>;
		};
	};
};

/*
 * USART3 has one owner, coprocessor-manager (src/services/coprocessor): the
 * console for ESP32 logs, a passthrough to cdc_acm_uart0, or the flasher. The
 * board's Zephyr bridge would take the UART's interrupt at init and can only be
 * stopped through device PM, so it is off (plan section 3, reports/p5).
 */
&{/uart-bridge0} {
	status = "disabled";
};

/*
 * The 8-byte receive FIFO: without it one byte waits in RDR for the next and is
 * lost if USART3's interrupt comes more than ~87 us late at 115200. Attempt 7
 * (reports/p6 hw/logs/14) caught a ROM answer to FLASH_DATA one byte short while
 * the CPU was 97 % busy; with the FIFO the interrupt may be ~700 us late.
 */
&usart3 {
	fifo-enable;
};

/*
 * esp-serial-flasher's target: the same USART3, EN (PA8) and BOOT strap (PC0)
 * that tests/esp_loader_integration proved on both boards. Stays at 115200
 * until the first flash through the web is accepted (owner's decision №7).
 *
 * zephyr,deferred-init: the library's device init would run esp_loader_init_serial()
 * at boot - tty_serial's handler on USART3 with its receive interrupt enabled and
 * nobody reading. An unflashed C6's ROM output fills the 512-byte ring, and the
 * handler then writes "~" per dropped byte from the ISR with K_FOREVER into a
 * transmit ring nobody drains: board B hung at boot (reports/p6, hw/logs/02).
 * The device is never initialised through the kernel; esp-loader-adapter runs the
 * port's init itself in `flashing`, right before connect, and deinit after.
 */
/ {
	esp_loader0: esp_loader {
		compatible = "espressif,esp-loader";
		uart = <&usart3>;
		reset-gpios = <&gpioa 8 GPIO_ACTIVE_LOW>;
		boot-gpios = <&gpioc 0 GPIO_ACTIVE_LOW>;
		default-baudrate = <115200>;
		higher-baudrate = <0>;
		num-trials = <10>;
		sync-timeout-ms = <100>;
		zephyr,deferred-init;
		status = "okay";
	};

	chosen {
		zephyr,esp-loader = &esp_loader0;
	};
};

/*
 * Independent watchdog for the STM32 update (owner's decision 2026-09-15): a new
 * image that hangs is reset and MCUboot reverts it. Started and fed by
 * src/services/system; the application only, MCUboot does not enable it.
 */
&iwdg {
	status = "okay";
};

/*
 * Relay outputs are active high: the pins drive ULN2003 inputs and a high input
 * energises the coil (reports/p0 finding 4, confirmed on board A's LEDs). The
 * board's common DTS says GPIO_ACTIVE_LOW, which turned a relay off when Matter
 * or the API switched it on, kept the coils energised while "off" and flipped
 * every relay twice on each reset. gpio-leds drives these to the inactive level
 * (low, coil off) at init.
 */
&relay_ac1 {
	gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
};

&relay_ac2 {
	gpios = <&gpioc 4 GPIO_ACTIVE_HIGH>;
};

&relay_ac3 {
	gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>;
};

&relay_ac4 {
	gpios = <&gpiob 2 GPIO_ACTIVE_HIGH>;
};

/*
 * PKA (public key accelerator): upstream stm32u5.dtsi has no node yet (STM32WBA
 * one is in zephyrproject-rtos/zephyr#116564). Binding st,stm32-pka and the driver:
 * modules/psa-driver-stm32. PKA_BASE_NS = AHB2PERIPH_BASE_NS + 0xA2000, PKAEN is
 * RCC_AHB2ENR1 bit 19, PKA_IRQn 97 (stm32u585xx.h).
 */
&{/soc} {
	pka: pka@420c2000 {
		compatible = "st,stm32-pka";
		reg = <0x420c2000 0x2000>;
		clocks = <&rcc STM32_CLOCK(AHB2, 19)>;
		interrupts = <97 0>;
		status = "okay";
	};
};

&clk_msis {
	status = "disabled";
	msi-range = <4>;
	msi-pll-mode;
};

&pll1 {
	div-m = <5>;
	mul-n = <64>;
	div-q = <2>;
	div-r = <2>;
	div-p = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&pll2 {
	status = "okay";
	clocks = <&clk_hse>;
	div-m = <5>;
	mul-n = <96>;
	div-p = <2>;
	div-q = <10>;
	div-r = <2>;
};

/*
 * Zephyr's coredump (prj.conf, owner's decisions 2026-09-18): THREADS level into the
 * STM32U585's internal flash, right after MCUboot's 128 KiB. The application runs
 * from the OSPI flash and never from here, so writing it from a fault touches
 * neither the code nor a shared bus, and Zephyr's flash-partition backend takes it
 * as it is (flash0 has write-block-size 16, erase-block-size 8 KiB). 256 KiB:
 * every thread's stack together is ~110 KiB. The backend finds it by the node
 * label coredump_partition.
 */
&flash0 {
	partitions {
		coredump_partition: partition@20000 {
			label = "coredump";
			reg = <0x00020000 DT_SIZE_K(256)>;
		};
	};
};

/*
 * VDDA through VREFINT and its factory calibration (src/diagnostic/vdd_monitor.c,
 * owner's request 2026-09-19: are the resets supply dips?). On this board VDDA is
 * tied straight to VDD, the LDO output. ADC1 is clocked from HCLK (160 MHz) / 4 =
 * 40 MHz, under the 55 MHz limit; the vref driver samples with the longest time
 * (814 cycles, ~20 us), well above VREFINT's minimum.
 */
&adc1 {
	st,adc-prescaler = <4>;
	status = "okay";
};

&vref1 {
	status = "okay";
};

/*
 * Status LED on PC2 (owner, 2026-09-19): blinks while the firmware runs
 * (src/io/status_led.c). Its polarity does not matter for a blink.
 */
/ {
	status-leds {
		compatible = "gpio-leds";

		status_led: status_led {
			gpios = <&gpioc 2 GPIO_ACTIVE_HIGH>;
			label = "Status LED";
		};
	};
};

/*
 * SPI1 (SPI NOR + FRAM only) with DMA (owner, 2026-09-19, reports/littlefs-speed):
 * raw NOR reads went from 240 KB/s (polling) to 3.6 MB/s in 4 KiB pieces. SPI1 has
 * requests only on GPDMA1 (LPDMA1 serves SPI3 only): SPI1_RX = 6, SPI1_TX = 7
 * (LL_GPDMA1_REQUEST_SPI1_*). Channels 10 and 11: linear channels (0-11, 8-byte
 * FIFO; 12-15 are the 2D ones), not used by anything else here. The SPI driver
 * with DCACHE accepts DMA buffers only in SRAM, so the NOR is reached through
 * nor_proxy below. The FRAM on the same bus has no proxy: read it only from a
 * thread whose stack is in SRAM into an SRAM buffer - from a PSRAM stack the SPI
 * driver returns -ENOTSUP. Nothing in the application uses the FRAM today (the MAC
 * comes from the I2C EEPROM at 0x50, src/lib-init/net_init.c).
 *
 * Checked against ST AN5593 (GPDMA, rev 9, table 24 and 2.2-2.4) and the channel
 * registers on the board: linear channels with the 2-word FIFO, requests 7/6, the
 * peripheral on port 0 - as recommended. Priority 2 (weighted, "high") as the note
 * recommends for peripherals (0 was the default). Two differences come from the Zephyr
 * drivers, not from here: the U5 DMA driver leaves the memory side on port 0 too
 * (AN5593: port 1), and spi_stm32 moves 8-bit frames as 8-bit beats (AN5593: 32-bit on
 * the SPI side); both cost only bus cycles (reports/littlefs-speed).
 */
&spi1 {
	dmas = <&gpdma1 10 7 (STM32_DMA_PERIPH_TX | STM32_DMA_PRIORITY_HIGH)>,
	       <&gpdma1 11 6 (STM32_DMA_PERIPH_RX | STM32_DMA_PRIORITY_HIGH)>;
	dma-names = "tx", "rx";
};

/*
 * The FRAM is an MB85RS64V (RDID 04 7F 03 02), rated for 20 MHz. The board's 60 MHz
 * gave 40 MHz on the bus (PCLK2 160 MHz / 4); 20 MHz is PCLK2 / 8 exactly.
 */
&fram0 {
	spi-max-frequency = <20000000>;
};

/*
 * The FRAM through the flash API for the energy counter's own ZMS (only the energy
 * lives there; settings stay on the NOR). modules/energy-meter, reports/energy.
 */
/ {
	fram_flash: fram-flash {
		compatible = "cedar,eeprom-flash";
		eeprom = <&fram0>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			energy_partition: partition@0 {
				label = "energy";
				reg = <0x0 0x2000>;
			};
		};
	};
};

/*
 * HLW8032: 4800 8E1 (datasheet), receive only - the board wires RX on PA3 and
 * nothing to TX. RX by DMA on GPDMA1 channel 9 (request 26 = USART2_RX; SPI1 has
 * 10 and 11), so the driver interrupts once per 24-byte frame.
 */
&usart2 {
	parity = "even";
	dmas = <&gpdma1 9 26 (STM32_DMA_PERIPH_RX | STM32_DMA_PRIORITY_HIGH)>;
	dma-names = "rx";
};

/*
 * The NOR's partitions (same offsets, sizes and labels as the board's
 * ext_flash_app.dts) move under nor_proxy (modules/flash-sram-proxy): every flash
 * area on the NOR - ZMS settings, slot 2, LittleFS, MCUboot scratch - is then read
 * and written from the proxy thread through its SRAM buffer, so the SPI DMA never
 * sees a stack or buffer in PSRAM. MCUboot is built without this overlay and keeps
 * using spi_flash directly.
 */
&spi_flash {
	/delete-node/ partitions;
};

/ {
	nor_proxy: nor-proxy {
		compatible = "cedar,flash-sram-proxy";
		backend = <&spi_flash>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			storage_zms_partition: partition@0 {
				label = "storage_zms";
				reg = <0x00000000 0x00600000>;
			};

			slot1_partition: partition@600000 {
				label = "image-1";
				reg = <0x00600000 0x00400000>;
			};

			storage_partition: partition@a00000 {
				label = "storage_nvs";
				reg = <0x00a00000 0x00500000>;
			};

			scratch_partition: partition@f00000 {
				label = "image-scratch";
				reg = <0x00f00000 0x00010000>;
			};
		};
	};
};
